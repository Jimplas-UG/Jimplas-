# Bilshenz — copy to .env locally. On Railway set these in the dashboard.
# Never commit real secrets.

# --- Profile ---
BILSHENZ_ENV=production

# --- Python bridge (Railway service: bilshenz-bridge) ---
HOST=0.0.0.0
PORT=8766
BRIDGE_TOKEN=change-me-long-random-token
SESSION_ENC_KEY=change-me-session-enc-key
BINANCE_SESSION_FILE=/data/binance-session.json
SCANNER_RISK_CONFIG_PATH=/data/scanner-risk.json
LOG_DIR=/data/logs
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=0
BINANCE_PAPER=0
SCANNER_EXEC=1
FORWARD_DRY_RUN=0
SCANNER_INVALIDATION_PCT=6.5
SCANNER_RESCUE_BUFFER_PCT=1.0

# --- Desk API (Railway service: bilshenz-desk) ---
DESK_API_PORT=8791
DESK_API_KEY=change-me-desk-api-key
PRODUCTION_MODE=1
# Private URL to bridge on Railway internal network:
BINANCE_API_URL=http://bilshenz-bridge.railway.internal:8766
AUTH_JWT_SECRET=change-me-jwt-secret
AUTH_DATA_DIR=/data/auth
# Comma-separated origins (Vercel + Expo web + local). Avoid * in production.
CORS_ORIGINS=https://YOUR-APP.vercel.app,http://localhost:8081
STRATEGY_FREEZE=1

# --- Expo / EAS (public only — no Binance secrets) ---
# EXPO_PUBLIC_DESK_API_URL=https://YOUR-RAILWAY-DESK.up.railway.app
# EXPO_PUBLIC_BINANCE_API_URL=https://YOUR-RAILWAY-DESK.up.railway.app/v1/binance
# EXPO_PUBLIC_DESK_API_KEY=change-me-desk-api-key
# EXPO_PUBLIC_AUTH_REQUIRED=1
# EXPO_PUBLIC_BROKER_MODE=binance
