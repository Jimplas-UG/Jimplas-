# Bilshenz VPS / DigitalOcean — copy to /etc/bilshenz.env (chmod 600)
# Never commit real secrets.

# --- Environment ---
BILSHENZ_ENV=production
LOG_DIR=/var/log/bilshenz

# --- Binance Futures bridge (Python, port 8766) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=1
BINANCE_PAPER=0
BINANCE_SYMBOL=XAUUSDT
BINANCE_LEVERAGE=10
BINANCE_MARGIN_TYPE=ISOLATED
HOST=0.0.0.0
PORT=8766
BRIDGE_TOKEN=change-me-long-random-token

# --- Desk API (Node, port 8791) ---
DESK_API_PORT=8791
DESK_API_KEY=change-me-desk-api-key
STRATEGY_FREEZE=1

# --- Forward bot (optional) ---
FORWARD_DRY_RUN=0
SCANNER_EXEC=1
FORWARD_POLL_SEC=45
RISK_PCT=0.005
