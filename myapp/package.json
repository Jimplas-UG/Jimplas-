{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/run-expo-go.js",
    "start:go": "node scripts/run-expo-go.js",
    "go:52": "node scripts/run-expo-go.js",
    "expo-go-52": "node scripts/run-expo-go.js",
    "start:lan": "node scripts/run-expo-go.js --lan",
    "start:tunnel": "expo start --tunnel --go",
    "start:clear": "node scripts/run-expo-go.js --clear",
    "start:usb": "node scripts/run-expo-go.js --usb",
    "fix:metro-firewall": "powershell -ExecutionPolicy Bypass -File ./scripts/allow-expo-metro-firewall.ps1",
    "qr": "node scripts/make-expo-qr.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:mobile": "node scripts/start-web-mobile.js",
    "mt5-bridge": "node ./mt5/bridge-server.mjs",
    "mt5-api": "powershell -ExecutionPolicy Bypass -File ../mt5_trading_system/python/start-api.ps1",
    "mt5:live": "powershell -ExecutionPolicy Bypass -File ../mt5_trading_system/python/start-api.ps1",
    "backtest:3yr": "npx tsx scripts/run-3yr-backtest.ts",
    "backtest:3mo": "npx tsx scripts/run-3mo-autotrade-backtest.ts",
    "backtest:xau12mo": "npx tsx scripts/run-xau-12mo-yahoo-backtest.ts",
    "backtest:xau12mo:mt5": "npx tsx scripts/run-xau-12mo-yahoo-backtest.ts --mt5-api=http://127.0.0.1:8765 --equity-from-mt5 --risk-pct=1",
    "backtest:xau12mo:realistic": "npx tsx scripts/run-xau-12mo-yahoo-backtest.ts --mt5-api=http://127.0.0.1:8765 --equity-from-mt5 --risk-pct=1 --realistic --broker-sl-pips=20",
    "backtest:xau1mo": "npx tsx scripts/run-xau-12mo-yahoo-backtest.ts --months=1 --window=start"
  },
  "dependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/slider": "4.5.5",
    "expo": "~52.0.49",
    "expo-blur": "~14.0.3",
    "expo-image-picker": "~16.0.6",
    "expo-splash-screen": "~0.29.24",
    "expo-status-bar": "~2.0.1",
    "luxon": "^3.7.2",
    "postcss-value-parser": "^4.2.0",
    "react": "18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "0.76.9",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "^0.19.13"
  },
  "private": true,
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/react": "~18.3.12",
    "qrcode": "^1.5.4",
    "typescript": "^5.3.3"
  }
}
