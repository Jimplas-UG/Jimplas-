[Unit]
Description=Bilshenz Binance Futures Bridge (Python)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bilshenz/binance_trading_system/python
EnvironmentFile=/etc/bilshenz.env
Environment=LOG_DIR=/var/log/bilshenz
StandardOutput=append:/var/log/bilshenz/binance-api.log
StandardError=append:/var/log/bilshenz/binance-api.log
ExecStart=/opt/bilshenz/binance_trading_system/python/.venv/bin/python main.py
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
