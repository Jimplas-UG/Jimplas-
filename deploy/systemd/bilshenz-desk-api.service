[Unit]
Description=Bilshenz Desk API (frozen strategy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bilshenz/backend
EnvironmentFile=/etc/bilshenz.env
StandardOutput=append:/var/log/bilshenz/desk-api.log
StandardError=append:/var/log/bilshenz/desk-api.log
ExecStart=/usr/bin/npx tsx src/server.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
