# /etc/bilshenz.env — chmod 600 — production VPS (Ubuntu 24.04)
# See DEPLOYMENT.md and .env.example at repo root.

BILSHENZ_ENV=production
LOG_DIR=/var/log/bilshenz

BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=0
BINANCE_PAPER=0
BINANCE_SYMBOL=XAUUSDT
BINANCE_LEVERAGE=10
BINANCE_MARGIN_TYPE=ISOLATED
HOST=0.0.0.0
PORT=8766
BRIDGE_TOKEN=change-me-long-random

DESK_API_PORT=8791
DESK_API_KEY=change-me-desk-key
PRODUCTION_MODE=1
AUTH_JWT_SECRET=change-me-min-32-chars-random-secret-here
STRATEGY_FREEZE=1

FORWARD_DRY_RUN=0
SCANNER_EXEC=1
FORWARD_POLL_SEC=45
RISK_PCT=0.005
