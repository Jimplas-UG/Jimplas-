# /etc/bilshenz.env for Oracle Cloud. Keep at chmod 600 and never commit real values.
# Moving from the old server? Copy its /etc/bilshenz.env instead, then apply the
# "Required on Oracle" lines below. SESSION_ENC_KEY must match or the saved login cannot decrypt.

# --- Required on Oracle ---
SCANNER_EXEC=0
REST_BAN_FILE=/var/lib/bilshenz/rest-ban.json
TRADE_HISTORY_CACHE_FILE=/var/lib/bilshenz/trade-history-cache.json
LOG_DIR=/var/log/bilshenz

# --- Secrets ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
BRIDGE_TOKEN=
DESK_API_KEY=
AUTH_JWT_SECRET=
SESSION_ENC_KEY=

# --- Mode: testnet stays on until mainnet is ordered ---
BINANCE_TESTNET=1
BINANCE_FORCE_TESTNET=1
BINANCE_FORCE_MAINNET=0
BINANCE_PAPER=0
BILSHENZ_ENV=production
PRODUCTION_MODE=1
STRATEGY_FREEZE=1
FORWARD_DRY_RUN=0
SCANNER_ENABLED=1

# --- Service ---
HOST=0.0.0.0
PORT=8766
DESK_API_PORT=8791
BINANCE_SYMBOL=BTCUSDT
BINANCE_LEVERAGE=10
BINANCE_MARGIN_TYPE=ISOLATED

# --- Frozen desk values ---
SCANNER_INVALIDATION_PCT=6.5
SCANNER_RESCUE_BUFFER_PCT=1.0
SCANNER_LONG_PULLBACK_PCT=0.5
SCANNER_SHORT_PULLBACK_PCT=1.5
SCANNER_SHORT_PULLBACK_MFE_PCT=1.5
SCANNER_SMART_EXIT_PCT=6.0
SCANNER_SHORT_PARTITION_PCT=50
SCANNER_LONG1_PARTITION_PCT=40
SCANNER_LONG2_PARTITION_PCT=40
