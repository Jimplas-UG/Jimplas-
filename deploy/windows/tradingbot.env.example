# Copy to: C:\ProgramData\Bilshenz\tradingbot.env
# Never commit the real file. Restrict ACL to Administrators + bot user only.
# Deploy guide: deploy/windows/DEPLOYMENT-GUIDE.md

STRATEGY_FREEZE=1
PRODUCTION_MODE=1
PRODUCTION_NO_EXPIRY=1

DESK_API_PORT=8791
DESK_API_KEY=change-me-long-random-secret

# BSV32 user auth (JWT) — required for mobile login gate
AUTH_JWT_SECRET=change-me-auth-jwt-secret-min-32-chars
# Dev only: log OTP codes and email verify links to console
# AUTH_DEV_OTP=1
# AUTH_GOOGLE_CLIENT_ID=
# AUTH_APPLE_CLIENT_ID=

# Run on VPS only — MT5 + API on same machine (127.0.0.1)
MT5_API_URL=http://127.0.0.1:8765
MT5_SYMBOL=XAUUSD
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 Exness

FORWARD_DRY_RUN=1
FORWARD_POLL_SEC=45
RISK_PCT=0.005

# Broker mode: mt5 | binance | paper (paper = Binance bridge with BINANCE_PAPER=1)
BROKER_MODE=binance
BINANCE_API_URL=http://127.0.0.1:8766
BINANCE_SYMBOL=BTCUSDT
FORWARD_SYMBOLS=*
FORWARD_MAX_SYMBOLS=40
BINANCE_TESTNET=1
BINANCE_PAPER=0
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# Shared secret for bridge HTTP auth (recommended on VPS/LAN)
# BRIDGE_TOKEN=change-me-bridge-token

MAX_DAILY_LOSS_PCT=3
MAX_DAILY_TRADES=3
MAX_API_FAILURES=8

TRADINGBOT_LOG_DIR=C:\logs\tradingbot
SAFETY_STATE_PATH=C:\logs\tradingbot\safety-state.json

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
