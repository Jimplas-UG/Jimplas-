# /etc/tradingbot.env — chmod 600. Never commit real values.

# --- Core ---
STRATEGY_FREEZE=1
PRODUCTION_MODE=1
PRODUCTION_NO_EXPIRY=1
DESK_API_PORT=8791
DESK_API_KEY=change-me-long-random-secret

# Remote Windows MT5 + Exness (required for live orders)
MT5_API_URL=http://YOUR_WINDOWS_IP:8765
MT5_SYMBOL=XAUUSD

# Binance mode (alternative to MT5)
BROKER_MODE=binance
BINANCE_API_URL=http://127.0.0.1:8766
BINANCE_SYMBOL=XAUUSDT
BINANCE_TESTNET=1
BINANCE_PAPER=0

FORWARD_DRY_RUN=1
FORWARD_POLL_SEC=45
RISK_PCT=0.005

# --- Safety ---
MAX_DAILY_LOSS_PCT=3
MAX_API_FAILURES=8
TRADINGBOT_LOG_DIR=/var/log/tradingbot
SAFETY_STATE_PATH=/var/log/tradingbot/safety-state.json

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
