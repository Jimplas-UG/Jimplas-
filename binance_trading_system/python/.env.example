# Copy to binance_trading_system/python/.env (local dev) or use /etc/bilshenz.env on VPS
# Never commit real keys.

BILSHENZ_ENV=development
LOG_LEVEL=INFO
LOG_DIR=./logs

HOST=0.0.0.0
PORT=8766
BRIDGE_TOKEN=

# Futures keys — testnet: https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=1
BINANCE_PAPER=0
BINANCE_SYMBOL=XAUUSDT
BINANCE_LEVERAGE=10
BINANCE_MARGIN_TYPE=ISOLATED

# Safety — set these to halt all live orders (signals still flow)
FORWARD_DRY_RUN=0
SCANNER_EXEC=1

# Scanner strategy (optional overrides)
# SCANNER_GAIN_PCT=5.0
# SCANNER_RETRACE_PCT=0.7
# SCANNER_LONG_PULLBACK_PCT=0.5
