      "env": {
        "BABEL_ENV": "production",
        "EAS_BUILD": "true",
        "EXPO_PUBLIC_DESK_LOCAL": "0",
        "EXPO_PUBLIC_DESK_REMOTE": "1",
        "EXPO_PUBLIC_DESK_API_URL": "http://157.245.33.42:8791",
        "EXPO_PUBLIC_BINANCE_API_URL": "http://157.245.33.42:8791/v1/binance"
      }
    },
    "production-local": {
