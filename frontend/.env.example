# Copy to .env.local or set before npm start (optional — run-expo-go.js sets LAN defaults).
EXPO_PUBLIC_DESK_API_URL=http://192.168.1.154:8791
EXPO_PUBLIC_DESK_API_KEY=dev
# Dev preview (npm run start:dev sets these automatically):
# EXPO_PUBLIC_DEV_PREVIEW=1
# EXPO_PUBLIC_MOCK_API=1
# EXPO_PUBLIC_SKIP_SPLASH=1
# Broker: mt5 (default) | binance | paper
EXPO_PUBLIC_BROKER_MODE=binance
EXPO_PUBLIC_BINANCE_API_URL=http://192.168.1.154:8791/v1/binance
# Do NOT set EXPO_PUBLIC_DESK_REMOTE=0 on Windows — phone uses desk-api, not backend TS.
# Advanced only: bundle backend engine on device
# EXPO_PUBLIC_DESK_LOCAL=1
